---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Dashboard de Instalaciones | Auto Market Kavak">
  <main class="mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-8 px-6 py-10 lg:px-10">
    <header class="space-y-2">
      <p class="text-muted-foreground text-sm font-semibold tracking-wide uppercase">
        Auto Market Kavak
      </p>
      <h1 class="text-foreground text-3xl font-semibold tracking-tight md:text-4xl">
        Dashboard de instalaciones
      </h1>
      <p class="text-muted-foreground max-w-3xl text-sm md:text-base">
        Base del proyecto lista para iniciar la construccion del dashboard con Astro, Shadcn y
        Tailwind.
      </p>
    </header>

    <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <article class="border-border bg-card rounded-2xl border p-4">
        <p class="text-muted-foreground text-sm">Estado del setup</p>
        <p class="text-foreground mt-2 text-lg font-semibold">Completado</p>
      </article>
      <article class="border-border bg-card rounded-2xl border p-4">
        <p class="text-muted-foreground text-sm">Integraciones</p>
        <p class="text-foreground mt-2 text-lg font-semibold">React + Tailwind + Shadcn</p>
      </article>
      <article class="border-border bg-card rounded-2xl border p-4">
        <p class="text-muted-foreground text-sm">Actualizacion de datos</p>
        <p class="text-foreground mt-2 text-lg font-semibold">Cada 5 minutos</p>
      </article>
      <article class="border-border bg-card rounded-2xl border p-4">
        <p class="text-muted-foreground text-sm">Modo de dashboard</p>
        <p class="text-foreground mt-2 text-lg font-semibold">Solo lectura</p>
      </article>
    </section>
  </main>
</Layout>
