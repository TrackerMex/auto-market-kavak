---
import Layout from "@/layouts/Layout.astro";
import { InstallationsDashboard } from "@/components/dashboard/installations-dashboard";
---

<Layout title="Dashboard de Instalaciones | Auto Market Kavak">
  <main class="mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-8 px-6 py-10 lg:px-10">
    <header class="space-y-2">
      <p class="text-muted-foreground text-sm font-semibold tracking-wide uppercase">
        Auto Market Kavak
      </p>
      <h1 class="text-foreground text-3xl font-semibold tracking-tight md:text-4xl">
        Dashboard de instalaciones
      </h1>
      <p class="text-muted-foreground max-w-3xl text-sm md:text-base">
        Integracion con Google Sheets, tabla virtualizada, filtros avanzados y preferencias persistentes.
      </p>
    </header>

    <InstallationsDashboard client:load />
  </main>
</Layout>
